# 한국관광공사 TourAPI 서비스키(이미 %-인코딩된 Encoding 키).
# 4개 외국어 서비스(Eng/Jpn/Chs/Cht Service2)의 areaBasedList2(쇼핑 contentTypeId=79)·detailCommon2 를 호출한다.
# ★ 이미 %-인코딩된 키다. 쿼리스트링에 verbatim 으로 붙인다. URLSearchParams/params 로 감싸면
#   재인코딩되어 403 SERVICE_KEY_IS_NOT_REGISTERED 가 난다(미구독과 헷갈리기 딱 좋다).
# NEXT_PUBLIC_ 접두사 금지 — 서버 시크릿이다.
DATA_GO_KR_KEY=

# Vercel Cron 캐시 예열(/api/warm) 인증용. Vercel 이 크론 호출에
# Authorization: Bearer <이 값> 을 붙여 보낸다. 설정 안 하면 /api/warm 은
# 503(fail closed) — 공개로 뚫려 아무나 예열을 돌리지 못하게 한다.
# 생성: openssl rand -hex 32
CRON_SECRET=
